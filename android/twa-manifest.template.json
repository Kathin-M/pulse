{
  "packageId": "${ANDROID_PACKAGE}",
  "host": "${PULSE_HOST}",
  "name": "Pulse",
  "launcherName": "Pulse",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0B0B0C",
  "themeColorDark": "#0B0B0C",
  "navigationColor": "#0B0B0C",
  "navigationColorDark": "#0B0B0C",
  "navigationDividerColor": "#0B0B0C",
  "navigationDividerColorDark": "#0B0B0C",
  "backgroundColor": "#0B0B0C",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "https://${PULSE_HOST}/icon-512.png",
  "maskableIconUrl": "https://${PULSE_HOST}/icon-maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "./android.keystore", "alias": "pulse" },
  "appVersionName": "1.${VERSION_CODE}",
  "appVersionCode": ${VERSION_CODE},
  "shortcuts": [],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://${PULSE_HOST}/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://${PULSE_HOST}/",
  "minSdkVersion": 24,
  "retainedBundles": []
}
