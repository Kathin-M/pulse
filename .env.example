# Copy to .env (never commit .env). All of these are read from the environment.

# MongoDB connection string (Atlas free tier works; docker-compose sets its own)
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="pulse"

# Optional: cap and rate-limit new accounts
PULSE_MAX_USERS="1000"
PULSE_SIGNUPS_PER_HOUR="30"

# Optional: GitHub repo (owner/name) whose releases carry the Android APK, for download links
PULSE_APP_REPO=""

# Random string used to sign the login cookie, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
PULSE_SECRET="replace-me"
